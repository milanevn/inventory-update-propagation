<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><parent><groupId>edu.inventory</groupId><artifactId>inventory-replication</artifactId><version>0.1.0-SNAPSHOT</version></parent><artifactId>cli-client</artifactId>
  <dependencies>
    <dependency><groupId>edu.inventory</groupId><artifactId>contracts</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId></dependency>
  </dependencies>
  <build><plugins>
    <!-- Executable jar: java -jar cli-client/target/cli-client-0.1.0-SNAPSHOT.jar localhost:9101 -->
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version>
      <configuration><mainClass>edu.inventory.cli.NodeStatusCli</mainClass></configuration>
      <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
    </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
      <configuration><mainClass>edu.inventory.cli.NodeStatusCli</mainClass></configuration>
    </plugin>
  </plugins></build>
</project>
